generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model itens_venda {
  item_id         Int      @id @default(autoincrement())
  item_quantidade Int      @default(1)
  item_precounit  Decimal  @db.Decimal(10, 2)
  item_venda_id   Int
  item_produto_id Int
  produtos        produtos @relation(fields: [item_produto_id], references: [produto_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_produto")
  vendas          vendas   @relation(fields: [item_venda_id], references: [venda_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_venda")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produtos {
  produto_id        Int           @id @default(autoincrement())
  produto_nome      String        @db.VarChar(100)
  produto_preco     Decimal       @db.Decimal(10, 2)
  produto_tamanho   String        @db.VarChar(10)
  produto_categoria String        @db.VarChar(50)
  imagem_url        String
  produto_estoque   Int           @default(1)
  produto_status    String        @default("disponivel") @db.VarChar(20)
  created_at        DateTime?     @default(now()) @db.Timestamp(6)
  itens_venda       itens_venda[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  usuario_id    Int       @id @default(autoincrement())
  usuario_nome  String    @db.VarChar(100)
  usuario_cpf   String    @unique @db.VarChar(14)
  usuario_email String    @unique @db.VarChar(100)
  usuario_senha String    @db.VarChar(255)
  role          String    @db.VarChar(10)
  usuario_ativo Boolean   @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  vendas        vendas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vendas {
  venda_id         Int           @id @default(autoincrement())
  venda_total      Decimal       @db.Decimal(10, 2)
  venda_formapagto String        @db.VarChar(20)
  venda_status     String        @default("finalizada") @db.VarChar(20)
  venda_data       DateTime?     @default(now()) @db.Timestamp(6)
  cancelada_em     DateTime?     @db.Timestamp(6)
  venda_usuario_id Int
  itens_venda      itens_venda[]
  usuarios         usuarios      @relation(fields: [venda_usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vendas_usuarios")
}
